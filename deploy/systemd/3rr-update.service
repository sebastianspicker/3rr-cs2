[Unit]
Description=3RR dedicated-server update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/3rr/apps/maintain/updater/3rr-update.sh
WorkingDirectory=/opt/3rr/apps/maintain/updater
# Covers both default SteamCMD calls, bounded systemctl retries, restoration,
# retry sleeps, and additional host overhead. Recalculate with the updater README
# formula whenever timeout or retry settings change; the unit deadline wins.
TimeoutStartSec=120min
# Allows a timed-out systemctl call plus bounded start/status restoration retries.
TimeoutStopSec=20min
