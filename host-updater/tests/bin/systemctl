#!/usr/bin/env bash
# Deterministic systemctl double for lifecycle ordering and recovery tests.
set -euo pipefail

calls_file="${SYSTEMCTL_CALLS_FILE:-/tmp/systemctl.calls}"
state_file="${SYSTEMCTL_STATE_FILE:-/tmp/systemctl.state}"
stop_exit="${SYSTEMCTL_STOP_EXIT:-0}"
start_exit="${SYSTEMCTL_START_EXIT:-0}"
start_state="${SYSTEMCTL_START_STATE:-active}"
stop_changes_state="${SYSTEMCTL_STOP_CHANGES_STATE:-0}"
signal_during_stop="${SYSTEMCTL_SIGNAL_DURING_STOP:-}"

action="${1:-}"
shift || true

record_event() {
    if [ -n "${UPDATER_EVENTS_FILE:-}" ]; then
        printf 'systemctl %s\n' "$1" >> "$UPDATER_EVENTS_FILE"
    fi
}

case "$action" in
    stop)
        record_event "stop"
        echo "stop" >> "$calls_file"
        if [ "$stop_changes_state" = "1" ]; then
            echo "inactive" > "$state_file"
        fi
        if [ -n "$signal_during_stop" ]; then
            # Exercise trap-based restart recovery at the interruption boundary.
            echo "inactive" > "$state_file"
            kill -s "$signal_during_stop" "$PPID"
        fi
        if [ "$stop_exit" -ne 0 ]; then
            exit "$stop_exit"
        fi
        echo "inactive" > "$state_file"
        exit 0
        ;;
    start)
        record_event "start"
        echo "start" >> "$calls_file"
        if [ "$start_exit" -ne 0 ]; then
            exit "$start_exit"
        fi
        echo "$start_state" > "$state_file"
        exit 0
        ;;
    is-active)
        record_event "is-active"
        echo "is-active" >> "$calls_file"
        if [ "${1:-}" = "--quiet" ]; then
            shift || true
        fi
        state="inactive"
        if [ -f "$state_file" ]; then
            state="$(cat "$state_file")"
        fi
        if [ "$state" = "active" ]; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "unsupported systemctl action: $action" >&2
        exit 2
        ;;
esac
