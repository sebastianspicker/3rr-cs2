#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC2317,SC2329 # Invoked indirectly by the signal traps below.
forward_signal() {
    local signal exit_code
    signal="$1"
    exit_code="$2"
    trap - INT TERM HUP
    kill -s "$signal" "$PPID"
    exit "$exit_code"
}

trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM
trap 'forward_signal HUP 129' HUP

if [[ "${1:-}" == "--version" ]]; then
    echo "timeout (GNU coreutils) 9.5"
    exit 0
fi

if [[ -n "${TIMEOUT_CALLS_FILE:-}" ]]; then
    printf '%s\n' "$*" >> "$TIMEOUT_CALLS_FILE"
fi

# Portable test double for GNU coreutils timeout. Normal test calls execute the
# wrapped command directly; TIMEOUT_FORCE_APP_UPDATE=1 converts a completed
# app_update invocation into timeout's conventional exit code 124.
while [[ $# -gt 0 ]]; do
    case "$1" in
        --foreground | --kill-after=*) shift ;;
        --)
            shift
            break
            ;;
        *)
            # First non-option is the duration.
            shift
            break
            ;;
    esac
done

args="$*"
wrapped_command="${1:-}"
wrapped_action="${2:-}"
set +e
"$@"
rc=$?
set -e

if [[ "${TIMEOUT_FORCE_APP_UPDATE:-0}" == "1" && "$args" == *"+app_update"* ]]; then
    exit 124
fi
if [[ -n "${TIMEOUT_FORCE_SYSTEMCTL_ACTION:-}" && "$wrapped_command" == "systemctl" && "$wrapped_action" == "$TIMEOUT_FORCE_SYSTEMCTL_ACTION" ]]; then
    exit 124
fi
exit "$rc"
