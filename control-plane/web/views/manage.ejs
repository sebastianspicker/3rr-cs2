<%# Authenticated per-server operations view with progressive live-status sections. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <%- include('partials/theme-boot') %>
  <meta name="color-scheme" content="dark light">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>3RR - <%= hostname && hostname !== '–' ? hostname : host %></title>
  <link rel="icon" href="/3rr-mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/panel.css">
</head>
<body class="manage-page">
  <a class="skip-link" href="#main">Skip to main content</a>
  <%
    const initialRconOnline = connected && authenticated;
    const initialRconUnknown = Boolean(hostname_error);
    const initialStatusDotClass = initialRconOnline ? 'online' : initialRconUnknown ? 'unknown' : 'offline';
    const initialStatusBadgeClass = initialRconOnline ? 'badge-connected' : initialRconUnknown ? 'badge-unknown' : 'badge-disconnected';
    const initialStatusLabel = initialRconOnline ? 'Connected' : initialRconUnknown ? 'Status not observed' : 'Disconnected';
    const rconStatusLocals = {
      initialRconOnline,
      initialRconUnknown,
      initialStatusDotClass,
      initialStatusBadgeClass,
      initialStatusLabel
    };
  %>
  <div class="shell ops-shell">
    <%- include('partials/navbar') %>
    <div class="main main-manage">
      <main class="container manage-workbench workbench" id="main" data-server-id="<%= server_id %>">
        <%- include('partials/manage/header', rconStatusLocals) %>
        <%- include('partials/manage/truth-rail', rconStatusLocals) %>

        <nav class="session-steps" aria-label="Session preparation">
          <a class="session-step" href="/servers">1 <span>Server</span></a>
          <button class="session-step" type="button" id="session-step-setup" aria-current="step">2 <span>Setup</span></button>
          <button class="session-step" type="button" id="session-step-result" disabled>3 <span>Check result</span></button>
        </nav>

        <section class="tabpanel manage-tabpanel" id="manage-panel-console" role="tabpanel" aria-labelledby="manage-tab-console" hidden>
          <%- include('partials/manage/console', rconStatusLocals) %>
        </section>
        <section class="tabpanel manage-tabpanel" id="manage-panel-match" role="tabpanel" aria-labelledby="manage-tab-match" hidden>
          <%- include('partials/manage/match-controls') %>
          <%- include('partials/manage/scrim') %>
          <%- include('partials/manage/practice') %>
        </section>
        <section class="tabpanel manage-tabpanel" id="manage-panel-players" role="tabpanel" aria-labelledby="manage-tab-players" hidden>
          <%- include('partials/manage/players') %>
        </section>
        <section class="tabpanel manage-tabpanel" id="manage-panel-setup" role="tabpanel" aria-labelledby="manage-tab-setup">
          <%- include('partials/manage/setup') %>
          <details class="session-advanced"><summary>Detailed server observations</summary><%- include('partials/manage/observed-status') %></details>
        </section>
        <div class="server-tools">
          <h2 class="visually-hidden">Server tools</h2>
        <div class="tabs manage-tabs" id="manage-tabs" role="tablist" aria-label="Server workbench">
          <button type="button" id="manage-tab-console" role="tab" aria-selected="false" tabindex="-1" aria-controls="manage-panel-console" data-manage-tab="console">Console</button>
          <button type="button" id="manage-tab-match" role="tab" aria-selected="false" aria-controls="manage-panel-match" data-manage-tab="match" tabindex="-1">Match</button>
          <button type="button" id="manage-tab-players" role="tab" aria-selected="false" aria-controls="manage-panel-players" data-manage-tab="players" tabindex="-1">Players <span class="tab-meta" id="manage-tab-player-count">–</span></button>
          <button type="button" id="manage-tab-setup" role="tab" aria-selected="true" aria-controls="manage-panel-setup" data-manage-tab="setup">Setup</button>
        </div>
          <div class="manage-header-actions"><button type="button" class="btn btn-secondary" id="command-palette-trigger" aria-haspopup="dialog">Commands <kbd>Ctrl K</kbd></button><button type="button" class="btn btn-secondary" id="manage-reconnect">Reconnect</button><button type="button" id="refresh_status" class="btn btn-secondary" aria-label="Refresh live status">Refresh observation</button></div>
        </div>
      </main>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="/js/console.js"></script>
</body>
</html>
