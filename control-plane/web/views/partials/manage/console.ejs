<section class="console-panel" id="console" aria-labelledby="console-heading">
          <h2 class="visually-hidden" id="console-heading">RCON Console</h2>
          <span class="visually-hidden"><span id="rcon-console-status-badge" class="badge <%= initialStatusBadgeClass %>" data-live-status-badge><%= initialStatusLabel %></span></span>
          <div class="truth-ledger" aria-label="Observed and requested server state">
            <div class="truth-row truth-row--observed">
              <span class="truth-time" id="truth-observed-time">Pending</span>
              <strong>Observed</strong>
              <span id="truth-observed-detail">Waiting for a live RCON observation</span>
            </div>
            <div class="truth-row truth-row--requested">
              <span class="truth-time" id="truth-requested-time">Saved</span>
              <strong>Requested</strong>
              <span id="truth-requested-detail"><%= requestedGameType %> / <%= requestedGameMode %> / <%= requestedMap %></span>
            </div>
          </div>
          <div class="rcon-terminal surface">
            <div id="rconResultBox" class="rcon-response">
              <div class="rcon-response-header">
                <span class="rcon-response-label">Console output</span>
                <button id="rconClearBtn" class="btn btn-ghost btn-sm" aria-label="Clear console output">Clear</button>
              </div>
              <pre id="rconResultText"></pre>
              <div class="console-empty"><p>Ready for a command</p><span>Responses from this server appear here.</span></div>
            </div>
            <label class="form-label rcon-input-label" for="rconInput">RCON command</label>
            <div class="input-row rcon-command-row">
            <input
              type="text"
              id="rconInput"
              name="rcon_command"
              class="form-control"
              placeholder="Enter a command…"
              aria-describedby="rcon-input-hint"
              aria-label="RCON command"
              autocomplete="off"
            >
            <button id="rconSuggestRefreshBtn" class="btn btn-secondary">Suggest</button>
            <button id="rconInputBtn" class="btn btn-primary">Send command</button>
            </div>
            <p id="rcon-input-hint" class="rcon-input-hint">Enter to send · ↑ ↓ command history</p>
            <div id="rconSuggestions" class="rcon-suggestions" hidden></div>
          </div>
          <div class="rcon-history-surface surface">
            <div class="rcon-history-header">
              <span class="rcon-response-label">Sent commands</span>
              <button id="rconHistoryClearBtn" class="btn btn-ghost btn-sm">Clear</button>
            </div>
            <div id="rconHistoryList" class="compact-list" aria-live="polite">
              <p class="empty-state">No sent RCON commands yet.</p>
            </div>
          </div>
          <details class="inline-advanced rcon-message-panel">
            <summary>Message players<span>Send an admin message to everyone on this server</span></summary>
            <div class="input-row mt-sm">
              <input
                type="text"
                id="say_input"
                name="say_message"
                class="form-control"
                placeholder="Say as admin… (Enter to send)"
                aria-label="Say as admin message"
                autocomplete="off"
              >
              <button id="say_input_btn" class="btn btn-secondary">Say</button>
            </div>
          </details>
          <p id="rcon-command-status" class="visually-hidden" role="status" aria-live="polite"></p>
</section>
