<div class="truth-rail session-observation-strip" aria-label="Server observations">
  <span class="visually-hidden" id="truth-rail-server"><%= hostname && hostname !== '–' ? hostname : host %></span>
  <div class="truth-rail-inner">
    <div class="rail-cell"><span class="rail-label" id="session-observation-label">Observed</span><span class="rail-value mono" id="truth-rail-observed-at">Not observed</span></div>
    <div class="rail-cell"><span class="rail-label">Map</span><span class="rail-value mono" id="truth-rail-map">Unknown</span></div>
    <div class="rail-cell"><span class="rail-label">Players</span><span class="rail-value" id="truth-rail-players">Unknown</span></div>
  </div>
</div>
