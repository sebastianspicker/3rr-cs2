<nav class="manage-breadcrumb" aria-label="Breadcrumb" hidden><a href="/servers">Choose server</a><span aria-hidden="true">/</span><span id="manage-breadcrumb-title"><%= hostname && hostname !== '–' ? hostname : 'Server ' + server_id %></span></nav>
    <div class="manage-header">
      <div class="manage-identity">
        <h1 id="manage-title" tabindex="-1"><%= hostname && hostname !== '–' ? hostname : 'Server ' + server_id %></h1>
        <div class="server-addr">

          <span class="manage-endpoint" id="truth-rail-endpoint"><%= host %>:<%= port %></span>
          <span id="manage-status-dot" class="status-dot <%= initialStatusDotClass %>" aria-hidden="true"></span>
          <span id="manage-status-badge" class="badge <%= initialStatusBadgeClass %>" data-live-status-badge>
            <%= initialStatusLabel %>
          </span>
          <span id="manage-observed-at" class="manage-observed-at visually-hidden">No observation yet</span>
        </div>
      </div>

    </div>
    <% if (initialRconUnknown) { %>
      <div class="alert alert-warning manage-initial-alert" id="manage-initial-alert" role="status">
        Initial RCON status was not observed. Live status will refresh below.
      </div>
    <% } else if (!initialRconOnline) { %>
      <div class="alert alert-disconnected manage-initial-alert" id="manage-initial-alert" role="alert">
        RCON is not connected. Commands will fail until the server reconnects. Use Reconnect to try again.
      </div>
    <% } %>
