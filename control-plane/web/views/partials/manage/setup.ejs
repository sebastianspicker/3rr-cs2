<section class="panel surface setup-panel session-panel" id="requested-setup" aria-labelledby="requested-setup-heading">
  <h2 id="requested-setup-heading" tabindex="-1">Prepare a session</h2>
  <p>Choose the setup to send to this server.</p>
  <p id="setup-status" class="alert" role="status" aria-live="polite" tabindex="-1" hidden></p>
  <button type="button" id="setup-retry" class="btn btn-secondary" hidden>Reload setup choices</button>
  <form id="server_setup_form">
    <fieldset id="setup-fields" class="session-fieldset">
      <legend class="visually-hidden">Session setup</legend>
      <div class="session-setup-grid">
        <div class="session-fields">
          <div id="gameTypeBtns" class="mb-3">
            <label class="form-label" id="game-type-label" for="gameTypeValue">Game type</label>
            <select id="gameTypeValue" name="game_type" class="form-select" required>
              <% gameTypes.forEach(type => { %>
                <option value="<%= type %>" data-game-type="<%= type %>" <%= type === requestedGameType ? 'selected' : '' %>><%= type.charAt(0).toUpperCase() + type.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <div id="gameModeBtns" class="mb-3">
            <label class="form-label" id="game-mode-label" for="gameModeValue">Mode</label>
            <select id="gameModeValue" name="game_mode" class="form-select" data-requested-mode="<%= requestedGameMode %>" required disabled><option value="">Loading modes…</option></select>
          </div>
          <div class="mb-3">
            <label for="selectedMap" class="form-label">Map</label>
            <select id="selectedMap" name="selectedMap" class="form-select" required disabled data-requested-map="<%= requestedMap %>"><option value="">Choose a game mode first</option></select>
          </div>
          <div class="session-team-fields">
            <div><label for="team1" class="form-label">Team 1 (optional)</label><input type="text" id="team1" name="team1" class="form-control" maxlength="64" autocomplete="off" aria-describedby="team-name-help"></div>
            <div><label for="team2" class="form-label">Team 2 (optional)</label><input type="text" id="team2" name="team2" class="form-control" maxlength="64" autocomplete="off" aria-describedby="team-name-help"></div>
          </div>
          <p id="team-name-help" class="small text-muted">Leave a name blank to keep the server's current team name.</p>
          <p id="setup-config-note" class="small text-muted"></p>
        </div>
        <aside class="session-review" aria-labelledby="setup-review-heading">
          <h3 id="setup-review-heading">Requested setup</h3>
          <p id="setup-review-mode">Loading choices…</p>
          <p id="setup-review-map" class="mono">—</p>
          <p id="setup-review-teams">Keep current team names</p>
          <p class="small text-muted">This shows the setup that will be sent to the server (not live data).</p>
        </aside>
      </div>
    </fieldset>
    <div class="session-warning" role="note"><span aria-hidden="true">⚠</span><div><strong id="setup-player-warning">Player count not observed</strong><p>Changing the map interrupts play.</p></div></div>
    <div class="session-actions"><a href="/servers" class="btn btn-secondary">Back</a><div><button id="send-setup-commands" type="submit" class="btn btn-primary" disabled>Send setup to <%= hostname && hostname !== '–' ? hostname : host + ':' + port %></button><p class="small text-muted">Sends setup commands. Live state is checked next.</p></div></div>
  </form>
</section>
<%- include('session-result') %>
<details class="inline-advanced setup-advanced session-advanced" id="advanced-setup">
  <summary>Workshop and advanced setup</summary>
  <button id="restart_game" type="button" class="btn btn-danger-outline setup-destructive">Restart round</button>
              <div class="mb-3">
                <label for="workshopUrl" class="form-label">Or paste Workshop URL</label>
                <div class="input-row">
                  <input type="text" id="workshopUrl" name="workshop_url" class="form-control"
                         placeholder="https://steamcommunity.com/sharedfiles/filedetails/?id=…" autocomplete="off">
                  <button type="button" id="loadWorkshopMap" class="btn btn-secondary">Load</button>
                </div>
                <small class="text-muted">Paste a Steam Workshop URL to load any workshop map</small>
              </div>
              <div class="mb-3 workshop-favorites">
                <div class="panel-subheader">
                  <span class="section-label">Workshop Favorites</span>
                  <button type="button" id="refreshWorkshopFavorites" class="btn btn-ghost btn-sm">Refresh</button>
                </div>
                <div class="input-row">
                  <input type="text" id="favoriteWorkshopName" class="form-control" placeholder="Favorite name" maxlength="80" aria-label="Workshop favorite name">
                  <input type="text" id="favoriteWorkshopId" class="form-control" placeholder="Workshop ID" maxlength="20" inputmode="numeric" aria-label="Workshop favorite ID">
                  <button type="button" id="addWorkshopFavorite" class="btn btn-secondary">Save</button>
                </div>
                <div id="workshopFavoritesList" class="compact-list" aria-live="polite">
                  <p class="empty-state">No favorites loaded.</p>
                </div>
              </div>
              <div class="mb-3">
                <label for="workshopCollectionId" class="form-label">Or load Workshop Collection</label>
                <div class="input-row">
                  <input type="text" id="workshopCollectionId" name="workshop_collection_id" class="form-control"
                         placeholder="Collection ID (5–20 digits)" maxlength="20" autocomplete="off">
                  <button type="button" id="loadWorkshopCollection" class="btn btn-secondary">Load</button>
                </div>
                <small class="text-muted">Loads all maps in a Workshop Collection for rotation</small>
              </div>
              <div class="mb-3">
                <label for="mapGroupSelect" class="form-label">Set Map Group</label>
                <div class="input-row">
                  <select id="mapGroupSelect" class="form-select">
                    <% mapGroups.forEach(function(group) { %>
                      <option value="<%= group.id %>"><%= group.displayName %> (<%= group.id %>)</option>
                    <% }) %>
                  </select>
                  <button type="button" id="setMapGroupBtn" class="btn btn-secondary">Set</button>
                </div>
                <small class="text-muted">Sets <code>mp_mapgroupname</code> for map cycling</small>
              </div>
</details>
