<%# Session login view; authentication and CSRF decisions remain server-side. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <%- include('partials/theme-boot') %>
  <meta name="color-scheme" content="dark light">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>3RR - Login</title>
  <link rel="icon" href="/3rr-mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/panel.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <main class="auth-page auth-page--login route-shell route-shell--auth" id="main">
    <section class="auth-brand route-intro" aria-labelledby="brand-title">
      <h1 class="brand-lockup" id="brand-title" aria-label="3RR">
        <span class="brand-name">3RR</span><span class="brand-slashes" aria-hidden="true">///</span><span class="nav-product">Operate</span>
      </h1>
      <p class="brand-descriptor">Self-hosted Counter-Strike 2 server operations</p>
    </section>
    <div class="auth-card route-workspace">
      <div class="panel">
        <h2 class="auth-title">Operator login</h2>
        <div class="auth-rule" aria-hidden="true"><span>///</span></div>
        <% if (locals.sessionExpired) { %>
        <div class="alert alert-warning" role="status">Your session expired. Sign in again to continue.</div>
        <% } %>
        <div id="error-msg" class="alert alert-danger" role="alert" hidden></div>
        <form id="login-form">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input
              type="text"
              id="username"
              name="username"
              class="form-control"
              autocomplete="username"
              spellcheck="false"
              required
              maxlength="255"
            >
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              autocomplete="current-password"
              required
              maxlength="1024"
            >
          </div>
          <div class="btn-container">
            <button id="login_btn" type="submit" class="btn btn-primary">Sign in</button>
            <button type="reset" class="btn btn-secondary">Clear</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/toast-inline.js"></script>
  <script nonce="<%= cspNonce %>">
    document.addEventListener('DOMContentLoaded', function () {
      var csrfToken = document.querySelector('meta[name="csrf-token"]').content;
      var form = document.getElementById('login-form');
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var submitButton = document.getElementById('login_btn');
        var username = document.getElementById('username').value;
        var password = document.getElementById('password').value;
        var errorEl = document.getElementById('error-msg');
        if (errorEl) {
          errorEl.setAttribute('hidden', 'hidden');
          errorEl.textContent = '';
        }
        if (!username || !password) {
          if (errorEl) {
            errorEl.textContent = 'Enter your username and password.';
            errorEl.removeAttribute('hidden');
          }
          return;
        }
        submitButton.disabled = true;
        submitButton.textContent = 'Signing in…';
        fetch('/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken,
          },
          body: JSON.stringify({ username: username, password: password }),
        })
          .then(function (resp) {
            return resp.json().then(function (data) {
              if (!resp.ok) {
                throw new Error(data.error || data.message || 'Login failed');
              }
              return data;
            });
          })
          .then(function (data) {
            window.location.href = '/servers';
          })
          .catch(function (err) {
            if (errorEl) {
              errorEl.textContent = err.message || 'Login failed';
              errorEl.removeAttribute('hidden');
            }
          })
          .finally(function () {
            submitButton.disabled = false;
            submitButton.textContent = 'Sign in';
          });
      });
    });
  </script>
</body>
</html>
