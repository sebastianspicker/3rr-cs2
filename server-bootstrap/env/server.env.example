# Reference-only runtime names; copy selected values into an untracked operator environment.
CS2_HOSTNAME=Example CS2 Server
CS2_MAP=de_dust2
CS2_PORT=27015
CS2_MAXPLAYERS=16
CS2_GSLT=
# Required: the wrapper and the Compose example refuse to start without it.
RCON_PASSWORD=
# Required by the Compose example: private address the panel reaches RCON on.
CS2_RCON_BIND_ADDRESS=
CS2_CFG_FILE=server.cfg
CSS_ADMINS_FILE=./bootstrap/admins.json
CSS_GROUPS_FILE=./bootstrap/admin_groups.json
# Optional read-only directory containing only the shipped cfg bundle.
CS2_CFG_BUNDLE_DIR=./assets/cfg
